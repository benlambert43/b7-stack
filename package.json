{
  "name": "create-b7-stack",
  "version": "0.1.0",
  "description": "Scaffolds a new project from the B7 Stack template: Next.js, Express, Drizzle, and PostgreSQL in one npm workspace.",
  "private": true,
  "type": "module",
  "bin": {
    "create-b7-stack": "dist/create.js"
  },
  "files": [
    "dist",
    "template"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "prepare": "tsc -p tsconfig.build.json && (husky || true)",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0",
    "lint:fix": "eslint --fix",
    "lint:shell": "shellcheck .husky/pre-commit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preflight": "npm run format:check && npm run typecheck && npm run lint && npm run lint:shell"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
